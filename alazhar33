  const p=data.permits.find(x=>x.id===permitId);
  if(!p){toast('Data izin tidak ditemukan.','error');return}
  const s=data.students.find(x=>x.id===p.studentId);
  if(!s){toast('Data siswa tidak ditemukan.','error');return}
  const cls=data.classes.find(c=>c.name===s.kelas);
  const walas=cls&&cls.walasId?data.teachers.find(t=>t.id===cls.walasId):null;
  const{jsPDF}=window.jspdf;const doc=new jsPDF();
  let y=pdfHeader(doc,'SURAT KETERANGAN IZIN','Dicetak: '+new Date().toLocaleString('id-ID'));
  doc.setTextColor(51,49,43);doc.setFont('helvetica','normal');doc.setFontSize(10);
  const intro=doc.splitTextToSize("Assalamu'alaikum Warahmatullahi Wabarakatuh. Yang bertanda tangan di bawah ini menerangkan bahwa peserta didik berikut telah mengajukan izin dengan rincian sebagai berikut:",182);
  doc.text(intro,14,y);y+=intro.length*4.8+7;
  const rows=[['Nama Peserta Didik',s.name],['NIS',s.nis],['Kelas',s.kelas],['Kategori Izin',p.type],['Tanggal',p.date],['Durasi',p.duration||'-'],['Keterangan',p.reason||'-'],['Status Pengajuan',p.status]];
  doc.setFontSize(10);
  rows.forEach(([label,val])=>{doc.setFont('helvetica','bold');doc.text(label,18,y);doc.setFont('helvetica','normal');const valLines=doc.splitTextToSize(': '+val,120);doc.text(valLines,78,y);y+=6.2*valLines.length});
  y+=6;
  const closing=doc.splitTextToSize('Demikian surat keterangan izin ini dibuat dengan sebenarnya untuk dapat dipergunakan sebagaimana mestinya.',182);
  doc.text(closing,14,y);y+=closing.length*4.8+8;
  doc.text("Wassalamu'alaikum Warahmatullahi Wabarakatuh.",14,y);
  if(y>225){doc.addPage();y=20}else{y+=18}
  doc.text('Bekasi, '+new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}),140,y-10);
  y+=8;
  doc.setFont('helvetica','normal');doc.text('Wali Kelas,',30,y);doc.text('Peserta Didik,',140,y);
  doc.text('(.........................)',30,y+26);doc.text('(.........................)',140,y+26);
  doc.setFont('helvetica','bold');
  doc.text(walas?walas.name:'(...........................)',30,y+31);
  doc.text(s.name,140,y+31);
  pdfFooter(doc);doc.save('Surat_Izin_'+s.name.replace(/\s+/g,'_')+'_'+today()+'.pdf');
  toast('Surat izin '+s.name+' berhasil diunduh.');
  logAction('Mencetak surat izin: '+s.name)
}
</script>
