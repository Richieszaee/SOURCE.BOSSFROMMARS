function filterTeachers(){const q=document.getElementById('tSrc')?.value?.toLowerCase()||'';document.querySelectorAll('#tGrid .cdi').forEach((c,i)=>{const t=data.teachers[i];if(t)c.style.display=(t.name.toLowerCase().includes(q)||t.subject.toLowerCase().includes(q))?'':'none'})}

function renderPoints(){document.getElementById('page-points').innerHTML=`<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;flex-wrap:wrap;gap:8px"><div class="stitle"><div class="st-i"><i class="fas fa-star"></i></div> Sistem Poin</div><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="b bw bsm" onclick="openSuratPelanggaranForm()"><i class="fas fa-file-alt"></i> Cetak Surat Pelanggaran</button><button class="b bb bsm" onclick="pdfPoints()"><i class="fas fa-file-pdf"></i> Ekspor Riwayat PDF</button></div></div><p class="sdesc" style="margin-top:0">Poin berjalan seperti akumulasi pelanggaran resmi: <strong>0 poin = Baik</strong>, semakin tinggi semakin berat, <strong>100 poin = dikeluarkan dari sekolah</strong>. Bisa pilih dari tata tertib untuk mengisi otomatis, atau tulis manual sesuai kebutuhan.</p><div class="g2" style="margin-bottom:14px"><div class="cd" style="padding:18px;border-top:3px solid var(--r)"><div style="font-size:14px;font-weight:700;color:var(--r);margin-bottom:4px"><i class="fas fa-plus-circle" style="margin-right:4px"></i>Catat Pelanggaran (Tambah Poin)</div><div style="font-size:11px;color:var(--tl);margin-bottom:12px">Bebas isi nama pelanggaran dan poin sendiri (manual) — atau pilih dari tata tertib untuk otomatis terisi.</div><div style="display:grid;gap:10px"><div class="fi"><label>Peserta Didik</label><select id="pt1"><option value="">— Pilih —</option>${data.students.map(s=>`<option value="${s.id}">${s.name} (${s.kelas}) · ${s.points} pts</option>`).join('')}</select></div><div class="fi"><label>Pilih dari Tata Tertib (opsional)</label><select id="ptR" onchange="if(this.value){const r=data.rules.find(x=>x.id===parseInt(this.value));if(r){document.getElementById('ptN1').value=r.name;document.getElementById('ptM').value=r.pointDeduction}}"><option value="">— Isi manual di bawah, atau pilih di sini —</option>${data.rules.filter(r=>r.pointDeduction>0).map(r=>`<option value="${r.id}">${r.name} (+${r.pointDeduction})</option>`).join('')}</select></div><div class="fi"><label>Nama Pelanggaran (manual)</label><input id="ptN1" placeholder="Tulis nama pelanggaran..."></div><div class="fi"><label>Poin (manual)</label><input id="ptM" type="number" placeholder="Jumlah poin" min="1"></div><button class="b br" style="width:100%" onclick="recordViolation()"><i class="fas fa-plus"></i> Tambah Poin Pelanggaran</button></div></div><div class="cd" style="padding:18px;border-top:3px solid var(--g)"><div style="font-size:14px;font-weight:700;color:var(--g);margin-bottom:4px"><i class="fas fa-minus-circle" style="margin-right:4px"></i>Remisi &amp; Prestasi (Kurangi Poin)</div><div style="font-size:11px;color:var(--tl);margin-bottom:12px">Bebas isi nama remisi/prestasi dan poin sendiri (manual) — atau pilih dari daftar untuk otomatis terisi.</div><div style="display:grid;gap:10px"><div class="fi"><label>Peserta Didik</label><select id="pt2"><option value="">— Pilih —</option>${data.students.map(s=>`<option value="${s.id}">${s.name} (${s.kelas}) · ${s.points} pts</option>`).join('')}</select></div><div class="fi"><label>Pilih Remisi / Penghargaan (opsional)</label><select id="ptW" onchange="if(this.value){const r=data.rules.find(x=>x.id===parseInt(this.value));if(r){document.getElementById('ptN2').value=r.name;document.getElementById('ptM2').value=Math.abs(r.pointDeduction)}}"><option value="">— Isi manual di bawah, atau pilih di sini —</option>${data.rules.filter(r=>r.pointDeduction<0).map(r=>`<option value="${r.id}">${r.name} (−${Math.abs(r.pointDeduction)})</option>`).join('')}</select></div><div class="fi"><label>Nama Remisi / Prestasi (manual)</label><input id="ptN2" placeholder="Tulis nama remisi/prestasi..."></div><div class="fi"><label>Poin (manual)</label><input id="ptM2" type="number" placeholder="Jumlah poin" min="1"></div><button class="b bp" style="width:100%;background:var(--g)" onclick="recordRemisi()"><i class="fas fa-minus"></i> Kurangi Poin (Remisi)</button></div></div></div><div class="cd" style="padding:18px"><div style="font-size:14px;font-weight:700;color:var(--td);margin-bottom:4px"><i class="fas fa-history" style="color:var(--pl);margin-right:4px"></i>Jejak Perubahan</div><div style="font-size:11px;color:var(--tl);margin-bottom:12px">Klik ↩ untuk membatalkan.</div><div style="max-height:380px;overflow-y:auto">${data.pointHistory.length?data.pointHistory.slice(0,30).map(x=>{const s=data.students.find(z=>z.id===x.studentId);return`<div class="hi"><i class="fas fa-${x.pointChange>0?'arrow-up':'arrow-down'}" style="color:${x.pointChange>0?'var(--r)':'var(--g)'}"></i><div style="flex:1"><div style="font-size:13px"><strong>${s?s.name:'—'}</strong> — ${x.reason}</div><div style="font-size:11px;color:var(--tl)">${x.date}</div></div><div class="mono" style="font-weight:700;color:${x.pointChange>0?'var(--r)':'var(--g)'}">${x.pointChange>0?'+':''}${x.pointChange}</div>${x.pointChange>0&&s?`<button class="b bw bxs" onclick="pdfSuratPelanggaran(${s.id},${x.id})" title="Cetak surat pelanggaran"><i class="fas fa-file-alt"></i></button>`:''}<button class="b bw bxs" onclick="undoPointChange(${x.id})"><i class="fas fa-undo"></i></button></div>`}).join(''):'<div class="empty"><i class="fas fa-inbox"></i><p>Belum ada riwayat.</p></div>'}</div></div>`}
function recordViolation(){const sid=parseInt(document.getElementById('pt1').value);if(!sid){toast('Pilih peserta didik.','error');return}const s=data.students.find(x=>x.id===sid);if(!s)return;const name=document.getElementById('ptN1').value.trim();const p=parseInt(document.getElementById('ptM').value);if(!name){toast('Nama pelanggaran wajib diisi.','error');return}if(!p||p<=0){toast('Poin wajib diisi (lebih dari 0).','error');return}s.points+=p;data.pointHistory.unshift({id:Date.now(),ts:Date.now(),studentId:sid,pointChange:p,reason:name,date:new Date().toLocaleString('id-ID'),prevPoints:s.points-p});logAction(`+${p} poin pelanggaran: ${s.name} — ${name}`);saveData();renderPoints();toast(`${p} poin pelanggaran dicatat untuk ${s.name}.`,'warning')}
function recordRemisi(){const sid=parseInt(document.getElementById('pt2').value);if(!sid){toast('Pilih peserta didik.','error');return}const s=data.students.find(x=>x.id===sid);if(!s)return;const name=document.getElementById('ptN2').value.trim();const p=parseInt(document.getElementById('ptM2').value);if(!name){toast('Nama remisi/prestasi wajib diisi.','error');return}if(!p||p<=0){toast('Poin wajib diisi (lebih dari 0).','error');return}s.points=Math.max(0,s.points-p);data.pointHistory.unshift({id:Date.now(),ts:Date.now(),studentId:sid,pointChange:-p,reason:name,date:new Date().toLocaleString('id-ID'),prevPoints:s.points+p});logAction(`−${p} poin (remisi/prestasi): ${s.name} — ${name}`);saveData();renderPoints();toast(`${p} poin dikurangi (remisi) untuk ${s.name}.`)}
function undoPointChange(hId){const idx=data.pointHistory.findIndex(h=>h.id===hId);if(idx===-1)return;const h=data.pointHistory[idx],s=data.students.find(x=>x.id===h.studentId);if(!s){toast('Siswa tidak ditemukan.','error');return}openModal(`<div class="mo-head"><div class="mo-icon" style="background:#f0e6d3;color:var(--y)"><i class="fas fa-undo"></i></div><div><div style="font-family:'Fraunces';font-weight:700;font-size:16px;color:var(--td)">Batalkan Perubahan</div><div style="font-size:12px;color:var(--tl)">Poin ${s.name} akan dikembalikan.</div></div></div><div class="mo-body"><p>Perubahan: <strong class="mono" style="color:${h.pointChange>0?'var(--r)':'var(--g)'}">${h.pointChange>0?'+':''}${h.pointChange}</strong> — ${h.reason}</p></div><div class="mo-foot"><button class="b bg" onclick="closeModal()">Batalkan</button><button class="b bw" onclick="confirmUndo(${hId})"><i class="fas fa-undo"></i> Ya, Undo</button></div>`)}
function confirmUndo(hId){const idx=data.pointHistory.findIndex(h=>h.id===hId);if(idx===-1)return;const h=data.pointHistory[idx],s=data.students.find(x=>x.id===h.studentId);if(s){s.points=Math.max(0,s.points-h.pointChange);logAction(`Undo ${h.pointChange>0?'+':''}${h.pointChange} poin: ${s.name}`)}data.pointHistory.splice(idx,1);saveData();closeModal();closeProfile();const cp=document.querySelector('.page-content[style*="block"]');if(cp?.id==='page-points')renderPoints();else if(cp?.id==='page-students')renderStudents();toast('Perubahan dibatalkan.')}
function renderPermits(){const cats=['Sakit','Izin Keluarga','Dispensasi','Konseling','Lainnya'];const fl=data.permits.filter(p=>{const s=data.students.find(x=>x.id===p.studentId);const mS=!pmS||(s&&s.name.toLowerCase().includes(pmS.toLowerCase()));const mSt=!pmSt||p.status===pmSt;const mC=!pmC||p.type===pmC;return mS&&mSt&&mC});const pend=data.permits.filter(p=>p.status==='Menunggu').length,app=data.permits.filter(p=>p.status==='Disetujui').length,rej=data.permits.filter(p=>p.status==='Ditolak').length;document.getElementById('page-permits').innerHTML=`<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px"><div class="stitle"><div class="st-i"><i class="fas fa-file-alt"></i></div> Izin & BK</div><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="b bw bsm" onclick="openSuratIzinForm()"><i class="fas fa-file-alt"></i> Cetak Surat Izin</button><button class="b bb bsm" onclick="pdfPermits()"><i class="fas fa-file-pdf"></i> Ekspor PDF</button></div></div><p class="sdesc" style="margin-top:0">Kelola pengajuan izin dan catatan bimbingan konseling.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px"><div class="cd" style="padding:12px 16px;flex:1;min-width:130px"><div style="font-size:10px;color:var(--tl);text-transform:uppercase;letter-spacing:.5px">Menunggu</div><div class="mono" style="font-size:22px;font-weight:700;color:var(--y)">${pend}</div></div><div class="cd" style="padding:12px 16px;flex:1;min-width:130px"><div style="font-size:10px;color:var(--tl);text-transform:uppercase;letter-spacing:.5px">Disetujui</div><div class="mono" style="font-size:22px;font-weight:700;color:var(--g)">${app}</div></div><div class="cd" style="padding:12px 16px;flex:1;min-width:130px"><div style="font-size:10px;color:var(--tl);text-transform:uppercase;letter-spacing:.5px">Ditolak</div><div class="mono" style="font-size:22px;font-weight:700;color:var(--r)">${rej}</div></div></div><div class="cd" style="padding:18px;margin-bottom:14px;border-top:3px solid var(--b)"><div style="font-size:14px;font-weight:700;color:var(--td);margin-bottom:12px"><i class="fas fa-plus" style="color:var(--pl);margin-right:5px"></i>Pengajuan Izin Baru</div><div class="g2"><div class="fi"><label>Peserta Didik</label><select id="pS"><option value="">— Pilih —</option>${data.students.map(s=>`<option value="${s.id}">${s.name} (${s.kelas})</option>`).join('')}</select></div><div class="fi"><label>Kategori</label><select id="pT">${cats.map(c=>`<option value="${c}">${c==='Konseling'?'Konseling BK':c==='Izin Keluarga'?'Keluarga':c}</option>`).join('')}</select></div><div class="fi"><label>Tanggal</label><input type="date" id="pD" value="${today()}"></div><div class="fi"><label>Durasi</label><input id="pDr" placeholder="1 hari, 2 jam..."></div><div class="fi" style="grid-column:span 2"><label>Keterangan</label><input id="pR" placeholder="Jelaskan alasan izin..."></div><div class="fi" style="grid-column:span 2"><label>Lampiran PDF (opsional)</label><div class="file-picker" id="pFilePicker"><div class="fp-btn" onclick="document.getElementById('pFile').click()"><i class="fas fa-upload"></i> Pilih File</div><span class="fp-name" id="pFileLabel">Belum ada file dipilih</span><span class="fp-check" id="pFileCheck"><i class="fas fa-check-circle"></i></span></div><input type="file" id="pFile" accept="application/pdf" style="display:none" onchange="handlePermitFileSelect(this)"><div style="font-size:11px;color:var(--tl);margin-top:4px"><i class="fas fa-info-circle" style="margin-right:3px"></i>Contoh: surat dokter, surat orang tua, atau BAP. Format PDF, maks. 4MB.</div></div></div><div style="display:flex;justify-content:flex-end;margin-top:8px"><button class="b bp" id="pSubmitBtn" onclick="createPermit()"><i class="fas fa-paper-plane"></i> Ajukan</button></div></div><div class="cd" style="padding:14px;margin-bottom:14px"><div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center"><div class="search-w" style="flex:1;min-width:200px"><i class="fas fa-search"></i><input class="input" placeholder="Cari nama siswa..." value="${pmS}" oninput="pmS=this.value;renderPermits()" style="padding-left:36px;height:40px"></div><select class="input" style="width:150px;height:40px" onchange="pmSt=this.value;renderPermits()"><option value="">Semua Status</option><option value="Menunggu" ${pmSt==='Menunggu'?'selected':''}>Menunggu</option><option value="Disetujui" ${pmSt==='Disetujui'?'selected':''}>Disetujui</option><option value="Ditolak" ${pmSt==='Ditolak'?'selected':''}>Ditolak</option></select><select class="input" style="width:160px;height:40px" onchange="pmC=this.value;renderPermits()"><option value="">Semua Kategori</option>${cats.map(c=>`<option value="${c}" ${pmC===c?'selected':''}>${c==='Konseling'?'Konseling BK':c==='Izin Keluarga'?'Keluarga':c}</option>`).join('')}</select></div></div><div class="cd" style="overflow:hidden"><div style="padding:14px 18px;border-bottom:1px solid var(--brd);font-size:14px;font-weight:700;color:var(--td)"><i class="fas fa-list" style="color:var(--b);margin-right:5px"></i>Daftar Izin</div>${fl.length?`<div style="overflow-x:auto"><table class="tb"><thead><tr><th>Tanggal</th><th>Siswa</th><th>Kategori</th><th>Keterangan</th><th>Lampiran</th><th>Status</th><th style="text-align:right">Aksi</th></tr></thead><tbody>${fl.map(p=>{const s=data.students.find(x=>x.id===p.studentId);return`<tr><td class="mono" style="font-size:12px;color:var(--tl)">${p.date}</td><td style="font-weight:600">${s?s.name:'—'}</td><td><span class="bd bd-b">${p.type}</span></td><td style="font-size:12px;color:var(--ts)">${p.reason}</td><td>${p.attachment?`<button class="b bg bxs" onclick="viewAttachment(${p.id})" title="Lihat lampiran PDF"><i class="fas fa-file-alt"></i> PDF</button>`:'<span style="color:var(--tl);font-size:11px">—</span>'}</td><td><select class="input" style="padding:4px 8px;font-size:11px;width:120px" onchange="updatePermitStatus(${p.id},this.value)"><option value="Menunggu" ${p.status==='Menunggu'?'selected':''}>Menunggu</option><option value="Disetujui" ${p.status==='Disetujui'?'selected':''}>Disetujui</option><option value="Ditolak" ${p.status==='Ditolak'?'selected':''}>Ditolak</option></select></td><td style="text-align:right"><button class="b bw bxs" onclick="pdfSuratIzin(${p.id})" title="Cetak surat izin" style="margin-right:4px"><i class="fas fa-file-alt"></i></button><button class="b br bxs" onclick="deletePermit(${p.id})"><i class="fas fa-trash"></i></button></td></tr>`}).join('')}</tbody></table></div>`:`<div class="empty"><i class="fas fa-file"></i><p>${data.permits.length?'Tidak ada hasil yang cocok.':'Belum ada pengajuan.'}</p></div>`}</div>`}
function handlePermitFileSelect(input){const picker=document.getElementById('pFilePicker'),label=document.getElementById('pFileLabel');const resetPicker=()=>{picker.classList.remove('has-file');label.textContent='Belum ada file dipilih'};const file=input.files&&input.files[0];if(!file){resetPicker();return}if(file.type!=='application/pdf'){toast('Lampiran harus berupa file PDF.','error');input.value='';resetPicker();return}if(file.size>4*1024*1024){toast('Ukuran PDF maksimal 4MB.','error');input.value='';resetPicker();return}picker.classList.add('has-file');label.textContent=file.name}
async function createPermit(){const sid=parseInt(document.getElementById('pS').value);if(!sid){toast('Pilih peserta didik.','error');return}const s=data.students.find(x=>x.id===sid),t=document.getElementById('pT').value,d=document.getElementById('pD').value,dr=document.getElementById('pDr').value.trim(),r=document.getElementById('pR').value.trim();if(!r){toast('Keterangan wajib diisi.','error');return}const fileInput=document.getElementById('pFile'),btn=document.getElementById('pSubmitBtn');let attachment=null;const file=fileInput&&fileInput.files&&fileInput.files[0];if(file){if(file.type!=='application/pdf'){toast('Lampiran harus berupa file PDF.','error');return}if(file.size>4*1024*1024){toast('Ukuran PDF maksimal 4MB.','error');return}if(btn){btn.disabled=true;btn.innerHTML='<i class="fas fa-upload"></i> Mengunggah...'}try{const dataUrl=await new Promise((res,rej)=>{const fr=new FileReader();fr.onload=()=>res(fr.result);fr.onerror=()=>rej(new Error('read failed'));fr.readAsDataURL(file)});attachment={name:file.name,dataUrl}}catch(e){toast('Gagal membaca file PDF.','error');if(btn){btn.disabled=false;btn.innerHTML='<i class="fas fa-paper-plane"></i> Ajukan'}return}}data.permits.unshift({id:data.nextId.permits++,studentId:sid,type:t,date:d,duration:dr,reason:r,status:'Menunggu',attachment,createdAt:new Date().toISOString()});logAction(`Izin ${t}: ${s.name}${attachment?' (dengan lampiran PDF)':''}`);saveData();renderPermits();toast(`Izin ${s.name} diajukan.${attachment?' Lampiran PDF tersimpan.':''}`)}
function viewAttachment(id){const p=data.permits.find(x=>x.id===id);if(!p||!p.attachment){toast('Tidak ada lampiran.','error');return}const s=data.students.find(x=>x.id===p.studentId);openModal(`<div class="mo-head"><div class="mo-icon" style="background:var(--p50);color:var(--pl)"><i class="fas fa-file-pdf"></i></div><div><div style="font-family:'Fraunces';font-weight:700;font-size:16px;color:var(--td)">Lampiran Izin</div><div style="font-size:12px;color:var(--tl)">${s?s.name:'—'} · ${p.attachment.name}</div></div></div><div class="mo-body" style="padding:0"><embed src="${p.attachment.dataUrl}" type="application/pdf" style="width:100%;height:60vh;border:none;display:block"></div><div class="mo-foot"><a class="b bg" href="${p.attachment.dataUrl}" download="${p.attachment.name}"><i class="fas fa-download"></i> Unduh</a><button class="b bp" onclick="closeModal()"><i class="fas fa-check"></i> Tutup</button></div>`)}
function updatePermitStatus(id,st){const p=data.permits.find(x=>x.id===id);if(p){p.status=st;const s=data.students.find(x=>x.id===p.studentId);logAction(`Status izin ${s?s.name:''}: ${st}`);saveData();toast(`Status → ${st}`,'info')}}
function deletePermit(id){data.permits=data.permits.filter(x=>x.id!==id);logAction('Menghapus izin');saveData();renderPermits();toast('Izin dihapus.','warning')}

function renderInsights(){
  const days=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
  const viowByDay=[0,0,0,0,0,0,0];
  data.pointHistory.filter(h=>h.pointChange>0).forEach(h=>{const d=entryDate(h);if(d)viowByDay[d.getDay()]++});
  const order=[1,2,3,4,5,6,0]; // Senin..Minggu
  const maxViol=Math.max(...order.map(i=>viowByDay[i]),1);
  const peakIdx=order.reduce((best,i)=>viowByDay[i]>viowByDay[best]?i:best,order[0]);
  const peakDay=days[peakIdx];
  const totalDeduct=data.pointHistory.filter(h=>h.pointChange>0).length;
  const hasEnoughData=totalDeduct>=5;
  const obsTitle=hasEnoughData?`Poin pelanggaran cenderung menumpuk di hari ${peakDay}`:'Belum cukup data untuk pola yang jelas';
  const obsBody=hasEnoughData?`Berdasarkan catatan yang ada, hari ${peakDay} paling sering mencatat poin pelanggaran baru. Ini bukan bukti sebab-akibat — hanya pola yang patut diperhatikan, misalnya untuk menjadwalkan pengawasan ekstra.`:'Catat lebih banyak mutasi poin agar pola mingguan dapat terlihat dengan jelas di sini.';
  const barColors=order.map(i=>{const ratio=viowByDay[i]/maxViol;if(viowByDay[i]===0)return 'var(--brd2)';if(i===peakIdx)return '#a3503f';if(ratio>0.6)return '#b3453a';if(ratio>0.3)return '#a87a2e';return '#5f7a5f'});
  document.getElementById('page-insights').innerHTML=`
    <div class="stitle"><div class="st-i"><i class="fas fa-lightbulb"></i></div> Wawasan</div>
    <p class="sdesc">Pola untuk diperhatikan — bukan kesimpulan pasti. Data dihitung otomatis dari catatan sistem.</p>
    <div class="g2">
      <div class="cd" style="padding:22px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px"><div style="width:26px;height:26px;border-radius:8px;background:var(--p50);color:var(--pl);display:flex;align-items:center;justify-content:center;font-size:12px"><i class="fas fa-lightbulb"></i></div><span style="font-size:10.5px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--tl)">Pengamatan Personal</span></div>
        <div class="serif" style="font-size:17px;font-weight:600;color:var(--td);margin-bottom:10px;line-height:1.35">${obsTitle}</div>
        <p style="font-size:13px;color:var(--tm);line-height:1.6">${obsBody}</p>
        <div class="divider"></div>
        <p style="font-size:11px;color:var(--tl)">Berdasarkan ${totalDeduct} poin pelanggaran bulan ini</p>
      </div>
      <div class="cd" style="padding:22px">
        <div class="serif" style="font-size:15px;font-weight:600;color:var(--td);margin-bottom:2px">Pola pelanggaran mingguan</div>
        <p style="font-size:11.5px;color:var(--ts);margin-bottom:10px">Sekilas catatan poin pelanggaran — bukan penilaian. Batang lebih tinggi berarti lebih banyak pelanggaran tercatat.</p>
        <div class="bd bd-r" style="margin-bottom:16px">Tertinggi: ${peakDay}</div>
