function pdfSummaryCards(doc,y,cards){
  if(y+27>268){doc.addPage();y=22}
  const margin=14,gap=4,w=(196-14-gap*(cards.length-1))/cards.length,h=22;
  cards.forEach((c,i)=>{
    const x=margin+i*(w+gap),bg=c.bg||[245,243,236],col=c.color||[60,58,50];
    doc.setFillColor(bg[0],bg[1],bg[2]);doc.roundedRect(x,y,w,h,2,2,'F');
    doc.setDrawColor(222,217,201);doc.setLineWidth(0.25);doc.roundedRect(x,y,w,h,2,2,'S');
    doc.setFillColor(col[0],col[1],col[2]);doc.roundedRect(x+4,y+3.2,w-8,1.1,0.5,0.5,'F');
    doc.setTextColor(col[0],col[1],col[2]);doc.setFont('helvetica','bold');doc.setFontSize(15);
    doc.text(String(c.value),x+w/2,y+13.5,{align:'center'});
    doc.setFont('helvetica','normal');doc.setFontSize(6.4);doc.setTextColor(126,123,112);
    doc.text(String(c.label).toUpperCase(),x+w/2,y+18.3,{align:'center'});
  });
  return y+h+9;
}

