function sanctionForPoints(p){
  if(p>=100)return'Rapat Pleno seluruh guru, dan/atau dikembalikan kepada orang tua.';
  if(p>=86)return'Pernyataan tertulis bermaterai Rp10.000, ditandatangani Kepala Sekolah, koordinator Tanse, orang tua, dan siswa yang bersangkutan.';
  if(p>=76)return'Surat Peringatan 3 (terakhir), pemanggilan orang tua, dan skorsing 3 hari efektif sekolah dengan pembinaan dari TNI atau Pondok Pesantren (biaya mandiri).';
  if(p>=61)return'Surat Peringatan 2, pemanggilan orang tua, dan skorsing selama 1 hari efektif sekolah.';
  if(p>=51)return'Surat Peringatan 1, pemanggilan orang tua, dan pembinaan langsung oleh Kepala Sekolah.';
  if(p>=26)return'Pembinaan oleh wali kelas dan BK, surat pemberitahuan kepada orang tua, dan surat perjanjian tertulis.';
  return'Pembinaan langsung oleh guru/wali kelas.';
}
function pdfSuratPelanggaran(studentId,historyIds){
  if(!Array.isArray(historyIds))historyIds=[historyIds];
  const s=data.students.find(x=>x.id===studentId);
  const list=historyIds.map(hid=>data.pointHistory.find(x=>String(x.id)===String(hid))).filter(Boolean);
  if(!s||!list.length){toast('Data siswa atau pelanggaran tidak ditemukan.','error');return}
  const{jsPDF}=window.jspdf;const doc=new jsPDF();
  let y=pdfHeader(doc,'SURAT PEMBERITAHUAN PELANGGARAN TATA TERTIB','Dicetak: '+new Date().toLocaleString('id-ID'));
  doc.setTextColor(51,49,43);doc.setFont('helvetica','normal');doc.setFontSize(10);
  doc.text('Kepada Yth.',14,y+2);
  doc.text('Orang Tua/Wali dari '+s.name,14,y+7.5);
  doc.text('Di Tempat',14,y+13);
  y+=24;
  const jumlahKata=list.length>1?'beberapa pelanggaran':'pelanggaran';
  const intro=doc.splitTextToSize(`Assalamu'alaikum Warahmatullahi Wabarakatuh. Sehubungan dengan pelaksanaan Tata Tertib SMAI Al Azhar 33 Jatimakmur, dengan ini kami sampaikan bahwa putra/putri Bapak/Ibu tercatat melakukan ${jumlahKata} tata tertib sekolah dengan rincian sebagai berikut:`,182);
  doc.text(intro,14,y);y+=intro.length*4.8+7;
  const totalPoin=list.reduce((a,h)=>a+h.pointChange,0);
  const infoRows=[['Nama Peserta Didik',s.name],['NIS',s.nis],['Kelas',s.kelas]];
  doc.setFontSize(10);
  infoRows.forEach(([label,val])=>{doc.setFont('helvetica','bold');doc.text(label,18,y);doc.setFont('helvetica','normal');doc.text(': '+val,78,y);y+=6.2});
  y+=3;
  doc.setFont('helvetica','bold');doc.text('Rincian Pelanggaran:',18,y);y+=6.5;
  list.forEach((h,i)=>{
    doc.setFont('helvetica','bold');doc.text((i+1)+'.',18,y);
    const lineLines=doc.splitTextToSize(h.reason+'  (Tanggal: '+h.date+')',150);
    doc.setFont('helvetica','normal');doc.text(lineLines,25,y);
    doc.setFont('helvetica','bold');doc.setTextColor(179,69,58);doc.text('+'+h.pointChange,182,y,{align:'right'});doc.setTextColor(51,49,43);
    y+=6*lineLines.length;
  });
  y+=2;
  doc.setFont('helvetica','bold');doc.text('Total Poin Pelanggaran Ini',18,y);doc.setFont('helvetica','normal');doc.text(': +'+totalPoin+' poin',78,y);y+=6.2;
  doc.setFont('helvetica','bold');doc.text('Akumulasi Poin Saat Ini',18,y);doc.setFont('helvetica','normal');doc.text(': '+s.points+' poin ('+pointLabel(s.points)+')',78,y);y+=10;
  const sanksi=sanctionForPoints(s.points);
  const sanksiLines=doc.splitTextToSize('Sanksi Berdasarkan Pasal 16 Tata Tertib: '+sanksi,172);
  const boxH=sanksiLines.length*4.6+9;
  if(y+boxH>265){doc.addPage();y=20}
  doc.setFillColor(255,247,237);doc.setDrawColor(217,169,74);doc.setLineWidth(0.4);doc.roundedRect(14,y,182,boxH,2.5,2.5,'FD');
  doc.setFont('helvetica','bold');doc.setTextColor(156,111,31);doc.text('SANKSI',19,y+6);
  doc.setFont('helvetica','normal');doc.setTextColor(51,49,43);doc.text(sanksiLines,19,y+11.5);
  y+=boxH+8;
  const closing=doc.splitTextToSize('Kami mohon kerja sama Bapak/Ibu untuk turut membina putra/putri agar tidak mengulangi pelanggaran serupa di kemudian hari.',182);
  doc.text(closing,14,y);y+=closing.length*4.8+8;
  if(y>250){doc.addPage();y=20}
  doc.text('Demikian surat pemberitahuan ini kami sampaikan. Atas perhatian dan kerja sama Bapak/Ibu, kami ucapkan terima kasih.',14,y,{maxWidth:182});y+=13;
  doc.text("Wassalamu'alaikum Warahmatullahi Wabarakatuh.",14,y);
  if(y>225){doc.addPage();y=20}else{y+=18}
  doc.text('Bekasi, '+new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}),140,y-10);
  y+=8;
  doc.setFont('helvetica','normal');
  doc.text('Koordinator Tanse,',30,y);
  doc.text('Peserta Didik yang bersangkutan,',130,y);
  doc.text('(.........................)',30,y+26);
  doc.text('(.........................)',130,y+26);
  doc.setFont('helvetica','bold');
  doc.text(s.name,130,y+31);
  pdfFooter(doc);doc.save('Surat_Pelanggaran_'+s.name.replace(/\s+/g,'_')+'_'+today()+'.pdf');
  toast('Surat pelanggaran '+s.name+' berhasil diunduh.');
