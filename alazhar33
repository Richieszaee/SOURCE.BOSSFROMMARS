function openTeacherForm(id){const t=id?data.teachers.find(x=>x.id===id):null;openModal(`<div class="mo-head"><div class="mo-icon" style="background:var(--p50);color:var(--pl)"><i class="fas fa-${t?'edit':'user-plus'}"></i></div><div><div style="font-family:'Fraunces';font-weight:700;font-size:16px;color:var(--td)">${t?'Perbarui Pengajar':'Registrasi Pengajar Baru'}</div><div style="font-size:12px;color:var(--tl)">${t?'Ubah informasi tenaga pendidik.':'Tambahkan pengajar baru ke sistem.'}</div></div></div><div class="mo-body"><div class="g2"><div class="fi" style="grid-column:span 2"><label>Nama Lengkap</label><input id="tName" value="${t?t.name:''}" placeholder="Nama beserta gelar..."></div><div class="fi"><label>NIP</label><input id="tNip" value="${t?t.nip:''}" placeholder="T00X"></div><div class="fi"><label>Bidang Studi</label><input id="tSub" value="${t?t.subject:''}" placeholder="Matematika"></div><div class="fi"><label>Telepon</label><input id="tPh" value="${t?t.phone:''}"></div><div class="fi"><label>Email</label><input id="tEm" value="${t?t.email:''}"></div></div></div><div class="mo-foot"><button class="b bg" onclick="closeModal()">Batalkan</button><button class="b bp" onclick="saveTeacher(${id||0})"><i class="fas fa-check"></i> ${t?'Simpan':'Daftarkan'}</button></div>`)}
