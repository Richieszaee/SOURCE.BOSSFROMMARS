function markAttendance(studentId,status,classId){const d=today();data.attendance=data.attendance.filter(a=>!(a.studentId===studentId&&a.date===d));if(status&&status!=='Hadir'){data.attendance.unshift({id:Date.now(),studentId,date:d,status})}const s=data.students.find(x=>x.id===studentId);logAction(`Absensi: ${s?s.name:''} — ${status}`);saveData();showClassProfile(classId)}
function showClassProfile(id){const c=data.classes.find(x=>x.id===id);if(!c)return;const all=data.students.filter(s=>s.kelas===c.name);const q=(clsQ||'').toLowerCase();const students=[...all].filter(s=>!q||s.name.toLowerCase().includes(q)).sort((a,b)=>a.name.localeCompare(b.name));const walas=c.walasId?data.teachers.find(t=>t.id===c.walasId):null;const meta=classMeta(c.name);const avgPts=all.length?Math.round(all.reduce((a,s)=>a+s.points,0)/all.length):0;const baik=all.filter(s=>s.points<26).length,waspada=all.filter(s=>s.points>=26&&s.points<76).length,kritis=all.filter(s=>s.points>=76).length;const lCount=all.filter(s=>s.gender==='L').length,pCount=all.filter(s=>s.gender==='P').length;const todayDate=today();const attMap={};data.attendance.filter(a=>a.date===todayDate).forEach(a=>{attMap[a.studentId]=a.status});const sumSakit=all.filter(s=>attMap[s.id]==='Sakit').length,sumIzin=all.filter(s=>attMap[s.id]==='Izin').length,sumAlpa=all.filter(s=>attMap[s.id]==='Alpa').length,sumHadir=all.length-sumSakit-sumIzin-sumAlpa;openProfile(`<div class="profile-head"><div class="p-avatar" style="background:${meta.color}2e;border-color:${meta.color}55"><i class="fas ${meta.icon}" style="color:#fff"></i></div><div style="font-family:'Fraunces';font-weight:700;font-size:20px;position:relative;z-index:1">Kelas ${c.name}</div><div style="opacity:.8;font-size:12px;position:relative;z-index:1">${all.length} peserta didik · ${lCount} L / ${pCount} P</div><div style="margin-top:12px;display:flex;gap:10px;justify-content:center;position:relative;z-index:1"><div style="background:rgba(0,0,0,.12);padding:8px 18px;border-radius:10px;text-align:center;backdrop-filter:blur(4px)"><div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;opacity:.7">Rata² Poin</div><div class="mono" style="font-size:24px;font-weight:700">${avgPts}</div></div><div style="background:rgba(0,0,0,.12);padding:8px 18px;border-radius:10px;text-align:center;backdrop-filter:blur(4px)"><div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;opacity:.7">Perlu Perhatian</div><div class="mono" style="font-size:24px;font-weight:700">${kritis}</div></div></div></div><div style="padding:24px"><div style="padding:12px;background:var(--bg);border-radius:9px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap"><div><div style="font-size:10px;color:var(--tl);text-transform:uppercase;letter-spacing:.5px">Wali Kelas</div><div style="font-weight:700;color:${walas?'var(--td)':'var(--tl)'};font-size:14px;margin-top:2px">${walas?walas.name:'Belum ditentukan'}</div>${walas?`<div style="font-size:11px;color:var(--tl);margin-top:1px">${walas.subject}${walas.phone?' · '+walas.phone:''}</div>`:''}</div><div style="display:flex;gap:6px">${walas&&walas.phone?`<a class="b bg bxs" href="tel:${walas.phone}" title="Hubungi wali kelas">Telp</a>`:''}<button class="b bg bxs" onclick="closeProfile();openClassWalasForm(${c.id})"><i class="fas fa-edit"></i> ${walas?'Ubah':'Tetapkan'}</button></div></div><div class="g2" style="gap:8px;margin-bottom:18px"><div style="padding:10px;background:var(--bg);border-radius:9px;text-align:center"><div style="font-size:9px;color:var(--tl);text-transform:uppercase">Baik</div><div class="mono" style="font-weight:700;font-size:18px;color:var(--g)">${baik}</div></div><div style="padding:10px;background:var(--bg);border-radius:9px;text-align:center"><div style="font-size:9px;color:var(--tl);text-transform:uppercase">Waspada</div><div class="mono" style="font-weight:700;font-size:18px;color:var(--y)">${waspada}</div></div><div style="padding:10px;background:var(--bg);border-radius:9px;text-align:center;grid-column:span 2"><div style="font-size:9px;color:var(--tl);text-transform:uppercase">Kritis / Dikeluarkan</div><div class="mono" style="font-weight:700;font-size:18px;color:var(--r)">${kritis}</div></div></div><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px"><div style="font-size:13px;font-weight:700;color:var(--td)"><i class="fas fa-clipboard-check" style="color:var(--pl);margin-right:5px"></i>Absensi Hari Ini</div></div><div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px"><span class="bd bd-g">Hadir: ${sumHadir}</span><span class="bd bd-y">Sakit: ${sumSakit}</span><span class="bd bd-b">Izin: ${sumIzin}</span><span class="bd bd-r">Alpa: ${sumAlpa}</span></div><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px"><div style="font-size:13px;font-weight:700;color:var(--td)"><i class="fas fa-user-graduate" style="color:var(--pl);margin-right:5px"></i>Daftar Peserta Didik</div><button class="b bb bxs" onclick="pdfClass(${c.id})"><i class="fas fa-file-pdf"></i> Ekspor</button></div><div class="search-w" style="margin-bottom:10px"><i class="fas fa-search"></i><input class="input" placeholder="Cari nama siswa..." value="${clsQ}" oninput="clsQ=this.value;showClassProfile(${c.id})" style="padding-left:36px;height:38px"></div>${students.length?students.map(s=>{const att=attMap[s.id]||'Hadir';return `<div class="hi" style="cursor:pointer" onclick="closeProfile();showStudentProfile(${s.id})"><div style="width:28px;height:28px;border-radius:7px;background:${s.gender==='L'?'#dfe6ea':'#ede1e6'};display:flex;align-items:center;justify-content:center;font-size:11px;color:${s.gender==='L'?'#4a6478':'#8a5568'}"><i class="fas fa-${s.gender==='L'?'mars':'venus'}"></i></div><div style="flex:1"><div style="font-size:13px;font-weight:600;color:var(--td)">${s.name}</div><div style="font-size:11px;color:var(--tl)">NIS ${s.nis}</div></div><span class="mono" style="font-weight:700;font-size:13px;color:${pointColor(s.points)};margin-right:6px">${s.points}</span><span class="bd ${pointBadgeClass(s.points)}" style="margin-right:6px">${pointLabel(s.points)}</span><select class="input" style="padding:3px 6px;font-size:10px;width:72px" onclick="event.stopPropagation()" onchange="markAttendance(${s.id},this.value,${c.id})"><option value="Hadir" ${att==='Hadir'?'selected':''}>Hadir</option><option value="Sakit" ${att==='Sakit'?'selected':''}>Sakit</option><option value="Izin" ${att==='Izin'?'selected':''}>Izin</option><option value="Alpa" ${att==='Alpa'?'selected':''}>Alpa</option></select>${att!=='Hadir'?`<button class="b bw bxs" style="padding:3px 7px" onclick="event.stopPropagation();markAttendance(${s.id},'Hadir',${c.id})" title="Batalkan, kembalikan ke Hadir"><i class="fas fa-undo"></i></button>`:''}</div>`}).join(''):'<div class="empty" style="padding:14px"><p>Tidak ada hasil.</p></div>'}<div style="display:flex;justify-content:flex-end;margin-top:16px"><button class="b bg" onclick="closeProfile()"><i class="fas fa-times"></i> Tutup</button></div></div>`)}
