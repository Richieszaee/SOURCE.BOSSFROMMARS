function applyAIActions(){if(!aiProposal||!aiProposal.actions){toast('Tidak ada usulan untuk diterapkan.','error');return}let count=0;const batch=[];aiProposal.actions.forEach(a=>{if(a.type==='add_points'){const s=data.students.find(x=>x.id===a.student_id);if(!s||!(a.points>0))return;const hEntry={id:Date.now()+Math.random(),ts:Date.now(),studentId:s.id,pointChange:a.points,reason:(a.reason||'Pelanggaran')+' (AI)',date:new Date().toLocaleString('id-ID'),prevPoints:s.points};s.points+=a.points;data.pointHistory.unshift(hEntry);logAction(`[AI] +${a.points} poin: ${s.name} — ${a.reason||'-'}`);batch.push({kind:'points',studentId:s.id,historyId:hEntry.id,delta:a.points});count++}else if(a.type==='reduce_points'){const s=data.students.find(x=>x.id===a.student_id);if(!s||!(a.points>0))return;const hEntry={id:Date.now()+Math.random(),ts:Date.now(),studentId:s.id,pointChange:-a.points,reason:(a.reason||'Remisi')+' (AI)',date:new Date().toLocaleString('id-ID'),prevPoints:s.points};s.points=Math.max(0,s.points-a.points);data.pointHistory.unshift(hEntry);logAction(`[AI] −${a.points} poin: ${s.name} — ${a.reason||'-'}`);batch.push({kind:'points',studentId:s.id,historyId:hEntry.id,delta:-a.points});count++}else if(a.type==='mark_attendance'){const s=data.students.find(x=>x.id===a.student_id);if(!s||!a.attendance_status)return;const d=today();const prevRec=data.attendance.find(x=>x.studentId===s.id&&x.date===d);const prevStatus=prevRec?prevRec.status:'Hadir';data.attendance=data.attendance.filter(x=>!(x.studentId===s.id&&x.date===d));if(a.attendance_status!=='Hadir'){data.attendance.unshift({id:Date.now()+Math.random(),studentId:s.id,date:d,status:a.attendance_status})}logAction(`[AI] Absensi: ${s.name} — ${a.attendance_status}`);batch.push({kind:'attendance',studentId:s.id,date:d,prevStatus});count++}else if(a.type==='assign_walas'){const c=data.classes.find(x=>x.id===a.class_id);const t=data.teachers.find(x=>x.id===a.teacher_id);if(!c||!t)return;const prevWalasId=c.walasId;c.walasId=t.id;logAction(`[AI] Wali kelas ${c.name}: ${t.name}`);batch.push({kind:'walas',classId:c.id,prevWalasId});count++}else if(a.type==='update_permit_status'){const p=data.permits.find(x=>x.id===a.permit_id);if(!p||!['Disetujui','Ditolak','Menunggu'].includes(a.status))return;const s=data.students.find(x=>x.id===p.studentId);const prevStatus=p.status;p.status=a.status;logAction(`[AI] Status izin ${s?s.name:''}: ${a.status}`);batch.push({kind:'permit',permitId:p.id,prevStatus});count++}else if(a.type==='add_student'){if(!a.name||!data.classes.some(c=>c.name===a.kelas))return;const newStudent={id:data.nextId.students++,name:a.name,nis:a.nis||'',kelas:a.kelas,gender:a.gender==='P'?'P':'L',phone:'',address:'',points:0};data.students.push(newStudent);logAction(`[AI] Menambahkan peserta didik baru: ${newStudent.name} (${newStudent.kelas})`);batch.push({kind:'newStudent',studentId:newStudent.id});count++}});lastAIBatch=batch;saveData();toast(`${count} tindakan AI berhasil diterapkan.`);aiProposal=null;document.getElementById('aiPrompt').value='';renderAIManagement()}
function undoLastAIBatch(){if(!lastAIBatch.length){toast('Tidak ada tindakan AI untuk diurungkan.','error');return}let n=0;[...lastAIBatch].reverse().forEach(b=>{if(b.kind==='points'){const s=data.students.find(x=>x.id===b.studentId);if(s)s.points=Math.max(0,s.points-b.delta);data.pointHistory=data.pointHistory.filter(h=>h.id!==b.historyId);n++}else if(b.kind==='attendance'){data.attendance=data.attendance.filter(x=>!(x.studentId===b.studentId&&x.date===b.date));if(b.prevStatus&&b.prevStatus!=='Hadir'){data.attendance.unshift({id:Date.now()+Math.random(),studentId:b.studentId,date:b.date,status:b.prevStatus})}n++}else if(b.kind==='walas'){const c=data.classes.find(x=>x.id===b.classId);if(c)c.walasId=b.prevWalasId;n++}else if(b.kind==='permit'){const p=data.permits.find(x=>x.id===b.permitId);if(p)p.status=b.prevStatus;n++}else if(b.kind==='newStudent'){data.students=data.students.filter(x=>x.id!==b.studentId);n++}});logAction(`[AI] Mengurungkan ${n} tindakan AI terakhir`);lastAIBatch=[];saveData();renderAIManagement();toast(`${n} tindakan AI berhasil diurungkan.`,'warning')}
