<?php
// --- CONFIGURATION ---
$API_PASS = "richie123";                          // ganti sesuai keinginan — HARUS SAMA dengan API_KEY di JS bawah
$DATA_FILE = __DIR__ . '/data.json';               // tempat seluruh data aplikasi disimpan
$LOG_FILE  = __DIR__ . '/log_aktivitas.json';      // tempat log aktivitas disimpan

function get_json_data($file) {
    if (!file_exists($file)) return null;
    $content = file_get_contents($file);
    $decoded = json_decode($content, true);
    return $decoded;
}

function save_json_data($file, $data) {
    file_put_contents($file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
}

// --- SIMPAN SELURUH DATA (dipanggil setiap kali ada perubahan) ---
if (isset($_POST['action']) && $_POST['action'] === 'save_data') {
    header('Content-Type: application/json');
    if (($_POST['pass'] ?? '') !== $API_PASS) {
        http_response_code(403);
        echo json_encode(['ok' => false, 'error' => 'Password salah']);
        exit;
    }
    $decoded = json_decode($_POST['data'] ?? 'null', true);
    save_json_data($DATA_FILE, $decoded);
    echo json_encode(['ok' => true]);
    exit;
}

// --- AMBIL SELURUH DATA (dipanggil saat halaman dibuka) ---
if (isset($_GET['action']) && $_GET['action'] === 'load_data') {
    header('Content-Type: application/json');
    if (($_GET['pass'] ?? '') !== $API_PASS) {
        http_response_code(403);
        echo json_encode(null);
        exit;
    }
    $d = get_json_data($DATA_FILE);
    echo json_encode($d);
    exit;
}

// --- TAMBAH SATU ENTRI LOG AKTIVITAS ---
if (isset($_POST['action']) && $_POST['action'] === 'log_action') {
    header('Content-Type: application/json');
    if (($_POST['pass'] ?? '') !== $API_PASS) {
        http_response_code(403);
        echo json_encode(['ok' => false]);
        exit;
    }
    $entries = get_json_data($LOG_FILE);
    if (!is_array($entries)) $entries = [];
    array_unshift($entries, [
        'action' => $_POST['log_action_text'] ?? '',
        'time'   => $_POST['log_time'] ?? date('d/m/Y H:i:s'),
        'user'   => $_POST['log_user'] ?? 'admin',
    ]);
    if (count($entries) > 500) $entries = array_slice($entries, 0, 500);
    save_json_data($LOG_FILE, $entries);
    echo json_encode(['ok' => true]);
    exit;
}
